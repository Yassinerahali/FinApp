+                {t("mcSavings")}
+              </label>
+              <div className={BOX}>
+                <AmountInput id={`${baseId}-savings`} value={plan.savings} onChange={(n) => set({ savings: n })} />
+                <span className="font-mono text-[10px] text-(--color-ink-soft)">MAD</span>
