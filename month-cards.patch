+      )}
+    </article>
+  );
+}
diff --git a/src/components/MonthCardsPanel.jsx b/src/components/MonthCardsPanel.jsx
new file mode 100644
index 0000000..eb54f12
--- /dev/null
+++ b/src/components/MonthCardsPanel.jsx
@@ -0,0 +1,166 @@
+import { useState } from "react";
+import { useLanguage } from "../lib/i18n/LanguageContext";
+import { formatAmount } from "../lib/format";
+import { currentMonthKey, monthLabel, monthStatus, planTotals } from "../lib/monthPlans";
+import MonthCard from "./MonthCard";
+
+const FILTERS = ["all", "past", "current", "upcoming"];
+const FILTER_KEYS = { all: "mcAll", past: "mcPast", current: "mcCurrent", upcoming: "mcUpcoming" };
+
+function Overview({ plans }) {
+  const { t, locale } = useLanguage();
+  const currentKey = currentMonthKey();
+  const rows = plans.map((p) => ({ plan: p, totals: planTotals(p) }));
+  const max = Math.max(1, ...rows.map((r) => Math.max(r.plan.salary, r.totals.total)));
+
+  return (
+    <section
+      aria-labelledby="mc-overview-title"
+      className="border border-(--color-rule) bg-(--color-paper) p-5 sm:p-6"
+    >
+      <h3 id="mc-overview-title" className="font-mono text-[11px] uppercase tracking-widest text-(--color-ink-soft) mb-3">
+        {t("mcChartTitle")}
+      </h3>
+      <div className="flex flex-wrap gap-x-4 gap-y-1 text-xs text-(--color-ink-soft) mb-4">
+        <span className="flex items-center gap-1.5">
+          <i className="inline-block size-3 border-2 border-(--color-ink-soft)" />
+          {t("mcLegendSalary")}
+        </span>
+        <span className="flex items-center gap-1.5">
+          <i className="inline-block size-3 bg-(--color-credit)" />
+          {t("mcLegendWithin")}
+        </span>
+        <span className="flex items-center gap-1.5">
+          <i className="inline-block size-3 bg-(--color-debit)" />
+          {t("mcLegendOver")}
+        </span>
+      </div>
+      <div className="flex items-end gap-2 overflow-x-auto pb-1">
+        {rows.map(({ plan, totals }) => {
+          const over = totals.total > plan.salary;
+          const { name, year } = monthLabel(plan.month, locale);
+          const isCurrent = plan.month === currentKey;
+          return (
+            <div key={plan.month} className="flex-1 min-w-16 flex flex-col items-center gap-1.5">
+              <div
+                className="h-32 w-full flex items-end justify-center gap-1 border-b border-(--color-rule)"
+                role="img"
+                aria-label={`${name} ${year}: ${t("mcLegendSalary")} ${formatAmount(plan.salary)}, ${t("mcExpenses")} ${formatAmount(totals.total)}`}
+              >
+                <div
+                  className="w-5 border-2 border-b-0 border-(--color-ink-soft) transition-all duration-500"
+                  style={{ height: `${Math.max(2, (plan.salary / max) * 100)}%` }}
+                />
+                <div
+                  className={`w-5 transition-all duration-500 ${over ? "bg-(--color-debit)" : "bg-(--color-credit)"}`}
+                  style={{ height: `${Math.max(2, (totals.total / max) * 100)}%` }}
+                />
+              </div>
+              <span
+                className={`text-xs font-semibold px-1.5 ${
+                  isCurrent ? "bg-(--color-brass) text-(--color-paper)" : ""
+                }`}
+              >
+                {name.slice(0, 3)} {String(year).slice(2)}
+              </span>
+              <span className="font-mono text-[11px] tabular text-(--color-ink-soft)">
+                {Math.round(totals.total).toLocaleString("en-US")}
+              </span>
+            </div>
+          );
+        })}
+      </div>
+    </section>
+  );
+}
+
+export default function MonthCardsPanel({ plans, loading, saveError, updatePlan, addMonth, deleteMonth }) {
+  const { t, locale } = useLanguage();
+  const [filter, setFilter] = useState("all");
+  const [justAdded, setJustAdded] = useState(null);
+  const currentKey = currentMonthKey();
+
+  async function handleAdd() {
+    const month = await addMonth();
+    setFilter("all");
+    setJustAdded(month);
+  }
+
+  const visible = plans.filter((p) => filter === "all" || monthStatus(p.month, currentKey) === filter);
+
+  return (
+    <div className="space-y-6 animate-fade-in-up">
+      <div className="flex flex-wrap items-end justify-between gap-3">
+        <div>
+          <h2 className="font-serif text-lg font-semibold tracking-tight">{t("mcTitle")}</h2>
+          <p className="font-mono text-[11px] uppercase tracking-widest text-(--color-ink-soft)">{t("mcSubtitle")}</p>
+        </div>
+        {plans.length > 0 && (
+          <button
+            type="button"
+            onClick={handleAdd}
+            className="bg-(--color-ink) text-(--color-paper) px-4 py-2 font-mono text-xs uppercase tracking-widest hover:bg-(--color-brass-dark)"
+          >
+            {t("mcAddNextMonth")}
+          </button>
+        )}
+      </div>
+
+      {saveError && (
+        <p role="alert" className="text-sm text-(--color-debit) font-medium">
+          {t("mcSaveError")}
+        </p>
+      )}
+
+      {loading ? (
+        <p className="text-sm text-(--color-ink-soft)">{t("mcLoading")}</p>
+      ) : plans.length === 0 ? (
+        <div className="border border-dashed border-(--color-rule) bg-(--color-paper) p-8 text-center space-y-4">
+          <p className="text-sm text-(--color-ink-soft)">{t("mcEmpty")}</p>
+          <button
+            type="button"
+            onClick={handleAdd}
+            className="bg-(--color-ink) text-(--color-paper) px-4 py-2 font-mono text-xs uppercase tracking-widest hover:bg-(--color-brass-dark)"
+          >
+            {t("mcStartMonth", { month: monthLabel(currentKey, locale).name })}
+          </button>
+        </div>
+      ) : (
+        <>
+          <Overview plans={plans} />
+
+          <div className="flex flex-wrap gap-1.5" role="group" aria-label={t("mcTitle")}>
+            {FILTERS.map((f) => (
+              <button
+                key={f}
+                type="button"
+                onClick={() => setFilter(f)}
+                aria-pressed={filter === f}
+                className={`px-3.5 py-1.5 font-mono text-xs uppercase tracking-widest border ${
+                  filter === f
+                    ? "bg-(--color-ink) border-(--color-ink) text-(--color-paper)"
+                    : "border-(--color-rule) text-(--color-ink-soft) hover:border-(--color-ink)"
+                }`}
+              >
+                {t(FILTER_KEYS[f])}
+              </button>
+            ))}
+          </div>
+
+          <div className="grid grid-cols-1 sm:grid-cols-2 gap-5 items-start">
+            {visible.map((plan) => (
+              <MonthCard
+                key={plan.month}
+                plan={plan}
+                phase={monthStatus(plan.month, currentKey)}
+                defaultOpen={plan.month === justAdded}
+                onChange={(updater) => updatePlan(plan.month, updater)}
+                onDelete={() => deleteMonth(plan.month)}
+              />
+            ))}
+          </div>
+        </>
+      )}
+    </div>
+  );
+}
diff --git a/src/hooks/useMonthPlans.js b/src/hooks/useMonthPlans.js
new file mode 100644
index 0000000..cb3da0e
--- /dev/null
+++ b/src/hooks/useMonthPlans.js
@@ -0,0 +1,110 @@
+import { useEffect, useState, useCallback, useRef } from "react";
+import { supabase } from "../lib/supabaseClient";
+import { rowToPlan, planToRow, planFrom, nextMonthKey, currentMonthKey } from "../lib/monthPlans";
+
+// Edits are applied on screen straight away and written to Supabase once
+// typing pauses, so a keystroke in an amount field doesn't cost a request.
+const SAVE_DELAY_MS = 700;
+
+const byMonth = (a, b) => (a.month < b.month ? -1 : a.month > b.month ? 1 : 0);
+
+export function useMonthPlans(userId) {
+  const [plans, setPlans] = useState([]);
+  const [loading, setLoading] = useState(true);
+  const [saveError, setSaveError] = useState(false);
+  const plansRef = useRef([]);
+  plansRef.current = plans;
+  const timers = useRef({});
+
+  useEffect(() => {
+    if (!userId) {
+      setPlans([]);
+      setLoading(false);
+      return;
+    }
+    let cancelled = false;
+    setLoading(true);
+    supabase
+      .from("month_plans")
+      .select("*")
+      .eq("user_id", userId)
+      .order("month", { ascending: true })
+      .then(({ data, error }) => {
+        if (cancelled) return;
+        if (error) setSaveError(true);
+        else if (data) setPlans(data.map(rowToPlan));
+        setLoading(false);
+      });
+    return () => {
+      cancelled = true;
+    };
+  }, [userId]);
+
+  const persist = useCallback(
+    async (month) => {
+      clearTimeout(timers.current[month]);
+      delete timers.current[month];
+      const plan = plansRef.current.find((p) => p.month === month);
+      if (!plan || !userId) return;
+      const { error } = await supabase
+        .from("month_plans")
+        .upsert(planToRow(plan, userId), { onConflict: "user_id,month" });
+      setSaveError(Boolean(error));
+    },
+    [userId]
+  );
+
+  // Don't lose an edit made in the last moments before leaving the page.
+  useEffect(() => {
+    const flush = () => {
+      for (const month of Object.keys(timers.current)) persist(month);
+    };
+    const onHide = () => {
+      if (document.visibilityState === "hidden") flush();
+    };
+    document.addEventListener("visibilitychange", onHide);
+    window.addEventListener("pagehide", flush);
+    return () => {
+      document.removeEventListener("visibilitychange", onHide);
+      window.removeEventListener("pagehide", flush);
+      flush();
+    };
+  }, [persist]);
+
+  /** updater receives the current plan and returns the changed plan. */
+  const updatePlan = useCallback(
+    (month, updater) => {
+      setPlans((prev) => prev.map((p) => (p.month === month ? updater(p) : p)));
+      clearTimeout(timers.current[month]);
+      timers.current[month] = setTimeout(() => persist(month), SAVE_DELAY_MS);
+    },
+    [persist]
+  );
+
+  /** Creates the month after the latest one (or this month if there are none). */
+  const addMonth = useCallback(async () => {
+    const list = plansRef.current;
+    const last = list[list.length - 1];
+    const month = last ? nextMonthKey(last.month) : currentMonthKey();
+    if (list.some((p) => p.month === month)) return month;
+    const next = [...list, planFrom(last, month)].sort(byMonth);
+    // Update the ref too, since persist reads it before React re-renders.
+    plansRef.current = next;
+    setPlans(next);
+    await persist(month);
+    return month;
+  }, [persist]);
+
+  const deleteMonth = useCallback(
+    async (month) => {
+      clearTimeout(timers.current[month]);
+      delete timers.current[month];
+      const { error } = await supabase.from("month_plans").delete().eq("user_id", userId).eq("month", month);
+      if (!error) setPlans((prev) => prev.filter((p) => p.month !== month));
+      setSaveError(Boolean(error));
+    },
+    [userId]
+  );
+
+  return { plans, loading, saveError, updatePlan, addMonth, deleteMonth };
+}
