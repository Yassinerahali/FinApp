# Get these from your Supabase project: Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Web push public key (see supabase/functions/send-push for the matching
# private key setup). Optional — without it, push notifications just
# don't appear as an option in the profile menu; everything else still
# works fine.
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
