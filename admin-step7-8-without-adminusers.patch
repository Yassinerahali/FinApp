new file mode 100644
index 0000000..e1eae55
--- /dev/null
+++ b/src/components/AdminFeatureAdoption.jsx
@@ -0,0 +1,71 @@
+import { useMemo } from "react";
+import { useLanguage } from "../lib/i18n/LanguageContext";
+
+// adoption: the row from admin_feature_adoption(), or null if it failed.
+// "Multiple accounts" is derived from the user list, so it always works.
+export default function AdminFeatureAdoption({ users, adoption, error }) {
+  const { t } = useLanguage();
+  const total = users.length;
+
+  const rows = useMemo(() => {
+    if (!adoption) return [];
+    const list = [
+      { key: "budgets", label: t("adminFeatBudgets"), count: Number(adoption.with_budgets) || 0 },
+      { key: "recurring", label: t("adminFeatRecurring"), count: Number(adoption.with_recurring) || 0 },
+      { key: "goals", label: t("adminFeatGoals"), count: Number(adoption.with_goals) || 0 },
+      { key: "loans", label: t("adminFeatLoans"), count: Number(adoption.with_loans) || 0 },
+      {
+        key: "categories",
+        label: t("adminFeatCategories"),
+        count: Number(adoption.with_custom_categories) || 0,
+      },
+      {
+        key: "accounts",
+        label: t("adminFeatAccounts"),
+        count: users.filter((u) => (Number(u.account_count) || 0) >= 2).length,
+      },
+      { key: "push", label: t("adminFeatPush"), count: Number(adoption.with_push) || 0 },
+    ];
+    return list.sort((a, b) => b.count - a.count);
+  }, [adoption, users, t]);
+
+  return (
+    <div className="border border-(--color-rule) bg-(--color-paper) p-5 sm:p-6 animate-fade-in-up">
+      <div className="flex flex-wrap items-baseline justify-between gap-2 mb-5">
+        <h2 className="font-serif text-lg font-semibold tracking-tight">{t("adminFeatTitle")}</h2>
+        <span className="font-mono text-[11px] uppercase tracking-widest text-(--color-ink-soft)">
+          {t("adminFeatSub")}
+        </span>
+      </div>
+
+      {error ? (
+        <p className="text-sm text-(--color-debit)">{t("adminFeatError")} ({error})</p>
+      ) : (
+        <>
+          <ul className="space-y-3">
+            {rows.map((r) => {
+              const pct = total > 0 ? Math.round((r.count / total) * 100) : 0;
+              return (
+                <li key={r.key} title={`${r.label}: ${r.count} / ${total}`}>
+                  <div className="flex items-baseline justify-between gap-3 text-sm">
+                    <span>{r.label}</span>
+                    <span className="font-mono tabular text-xs text-(--color-ink-soft) whitespace-nowrap">
+                      {t("adminFeatOf", { count: r.count, total, pct })}
+                    </span>
+                  </div>
+                  <div className="mt-1.5 h-1.5 w-full bg-(--color-rule) overflow-hidden">
+                    <div
+                      className="h-full bg-(--color-brass) transition-all duration-500 ease-out"
+                      style={{ width: `${pct}%` }}
+                    />
+                  </div>
+                </li>
+              );
+            })}
+          </ul>
+          <p className="mt-4 text-xs text-(--color-ink-soft)">{t("adminFeatAiNote")}</p>
+        </>
+      )}
+    </div>
+  );
+}
diff --git a/src/components/AdminUserActions.jsx b/src/components/AdminUserActions.jsx
new file mode 100644
index 0000000..520c6ce
--- /dev/null
+++ b/src/components/AdminUserActions.jsx
@@ -0,0 +1,168 @@
+import { useEffect, useState } from "react";
+import { adminUserAction } from "../lib/adminClient";
+import { useLanguage } from "../lib/i18n/LanguageContext";
+
+const ACTION_BUTTON =
+  "px-3 py-2 border font-mono text-xs uppercase tracking-widest transition-colors disabled:opacity-50";
+
+export default function AdminUserActions({ user, onClose, onChanged }) {
+  const { t } = useLanguage();
+  const [busy, setBusy] = useState("");
+  const [message, setMessage] = useState("");
+  const [error, setError] = useState("");
+  const [confirmEmail, setConfirmEmail] = useState("");
+  const [deleting, setDeleting] = useState(false);
+
+  const name = [user.first_name, user.last_name].filter(Boolean).join(" ");
+  const disabled = Boolean(user.banned_until) && new Date(user.banned_until) > new Date();
+  const emailMatches = confirmEmail.trim().toLowerCase() === (user.email || "").toLowerCase();
+
+  useEffect(() => {
+    function onKey(e) {
+      if (e.key === "Escape" && !busy) onClose();
+    }
+    document.addEventListener("keydown", onKey);
+    return () => document.removeEventListener("keydown", onKey);
+  }, [busy, onClose]);
+
+  async function run(action, doneKey, extra) {
+    setBusy(action);
+    setError("");
+    setMessage("");
+    try {
+      await adminUserAction(action, user.id, extra);
+      if (action === "delete") {
+        onChanged();
+        onClose();
+        return;
+      }
+      setMessage(t(doneKey));
+      if (action !== "reset_password") onChanged();
+    } catch (err) {
+      setError(`${t("adminActionError")} (${err.message})`);
+    } finally {
+      setBusy("");
+    }
+  }
+
+  return (
+    <div
+      className="fixed inset-0 z-30 flex items-center justify-center p-4 bg-(--color-ink)/40 animate-fade-in"
+      onClick={() => !busy && onClose()}
+    >
+      <div
+        role="dialog"
+        aria-modal="true"
+        aria-label={t("adminManageTitle")}
+        onClick={(e) => e.stopPropagation()}
+        className="w-full max-w-lg max-h-[90vh] overflow-y-auto border border-(--color-rule) bg-(--color-paper) p-6 animate-scale-in"
+      >
+        <div className="flex items-baseline justify-between mb-1">
+          <h2 className="font-serif text-lg font-semibold tracking-tight">{t("adminManageTitle")}</h2>
+          <button
+            onClick={onClose}
+            disabled={Boolean(busy)}
+            aria-label={t("adminClose")}
+            className="text-(--color-ink-soft) hover:text-(--color-ink) text-sm"
+          >
+            ✕
+          </button>
+        </div>
+        <p className="text-sm mb-5">
+          {name && <span className="font-semibold">{name} · </span>}
+          <span className="text-(--color-ink-soft) break-all">{user.email}</span>
+          {disabled && (
+            <span className="ms-2 font-mono text-[10px] uppercase tracking-widest text-(--color-debit)">
+              {t("adminDisabled")}
+            </span>
+          )}
+        </p>
+
+        {message && <p className="mb-4 text-sm text-(--color-credit)">{message}</p>}
+        {error && <p className="mb-4 text-sm text-(--color-debit) break-words">{error}</p>}
+
+        <div className="space-y-5">
+          <section>
+            <p className="text-xs text-(--color-ink-soft) mb-2">
+              {t("adminResetPwDesc", { email: user.email })}
+            </p>
+            <button
+              onClick={() => run("reset_password", "adminResetSent")}
+              disabled={Boolean(busy)}
+              className={`${ACTION_BUTTON} border-(--color-rule) hover:border-(--color-brass)`}
+            >
+              {busy === "reset_password" ? t("pleaseWait") : t("adminResetPw")}
+            </button>
+          </section>
+
+          <section className="pt-5 border-t border-(--color-rule)">
+            <p className="text-xs text-(--color-ink-soft) mb-2">
+              {disabled ? t("adminEnableDesc") : t("adminDisableDesc")}
+            </p>
+            <button
+              onClick={() =>
+                disabled
+                  ? run("enable", "adminEnabledDone")
+                  : run("disable", "adminDisabledDone")
+              }
+              disabled={Boolean(busy)}
+              className={`${ACTION_BUTTON} border-(--color-rule) hover:border-(--color-brass)`}
+            >
+              {busy === "disable" || busy === "enable"
+                ? t("pleaseWait")
+                : disabled
+                  ? t("adminEnable")
+                  : t("adminDisable")}
+            </button>
+          </section>
+
+          <section className="pt-5 border-t border-(--color-rule)">
+            <p className="text-xs text-(--color-ink-soft) mb-2">{t("adminDeleteDesc")}</p>
+            {!deleting ? (
+              <button
+                onClick={() => setDeleting(true)}
+                disabled={Boolean(busy)}
+                className={`${ACTION_BUTTON} border-(--color-debit) text-(--color-debit) hover:bg-(--color-debit) hover:text-(--color-paper)`}
+              >
+                {t("adminDelete")}
+              </button>
+            ) : (
+              <div className="space-y-2 animate-fade-in-up">
+                <label className="block text-xs">
+                  {t("adminDeleteConfirmLabel", { email: user.email })}
+                  <input
+                    value={confirmEmail}
+                    onChange={(e) => setConfirmEmail(e.target.value)}
+                    autoFocus
+                    autoComplete="off"
+                    dir="ltr"
+                    className="mt-1 w-full border border-(--color-rule) bg-transparent px-3 py-2 text-sm"
+                  />
+                </label>
+                <div className="flex gap-2">
+                  <button
+                    onClick={() => run("delete", "adminDeletedDone", { confirmEmail })}
+                    disabled={!emailMatches || Boolean(busy)}
+                    className={`${ACTION_BUTTON} border-(--color-debit) bg-(--color-debit) text-(--color-paper)`}
+                  >
+                    {busy === "delete" ? t("pleaseWait") : t("adminDeleteButton")}
+                  </button>
+                  <button
+                    onClick={() => {
+                      setDeleting(false);
+                      setConfirmEmail("");
+                    }}
+                    disabled={Boolean(busy)}
+                    className={`${ACTION_BUTTON} border-(--color-rule) hover:border-(--color-brass)`}
+                  >
+                    {t("cancel")}
+                  </button>
+                </div>
+              </div>
+            )}
+          </section>
+        </div>
+      </div>
+    </div>
+  );
+}
diff --git a/src/lib/adminClient.js b/src/lib/adminClient.js
new file mode 100644
index 0000000..59b4c0c
--- /dev/null
+++ b/src/lib/adminClient.js
@@ -0,0 +1,28 @@
+import { supabase } from "./supabaseClient";
+
+async function readError(error) {
+  try {
+    if (error.context?.json) {
+      const body = await error.context.json();
+      if (body?.error) return body.error;
+    }
+  } catch {
+    // fall through to the generic message below
+  }
+  return error.message || "Something went wrong.";
+}
+
+/**
+ * Runs an account action through the admin-users edge function (which
+ * re-checks on the server that the caller is the admin).
+ * action: "reset_password" | "disable" | "enable" | "delete"
+ * For "delete", pass { confirmEmail } — the user's exact email.
+ */
+export async function adminUserAction(action, userId, extra = {}) {
+  const { data, error } = await supabase.functions.invoke("admin-users", {
+    body: { action, userId, ...extra },
+  });
+  if (error) throw new Error(await readError(error));
+  if (data?.error) throw new Error(data.error);
+  return data;
+}
