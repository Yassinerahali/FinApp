diff --git a/supabase/functions/admin-users/index.ts b/supabase/functions/admin-users/index.ts
new file mode 100644
index 0000000..f5ac9a0
--- /dev/null
+++ b/supabase/functions/admin-users/index.ts
@@ -0,0 +1,162 @@
+// Supabase Edge Function: admin-users
+// Account management for the Admin tab: send a password-reset email,
+// disable / re-enable a user, or delete a user and all their data.
+//
+// Why this is an edge function: these actions need the service role key,
+// which bypasses all row-level security. That key lives only here (it is
+// provided to edge functions automatically) and is never sent to the
+// browser. Every request is re-checked on the server: the caller must be
+// signed in as the confirmed admin account below, and the admin account
+// itself can never be targeted.
+//
+// Deploy via the Supabase Dashboard (Edge Functions -> Deploy a new
+// function, name it exactly "admin-users") or the CLI:
+//   supabase functions deploy admin-users
+// Optional secret: SITE_URL (e.g. https://your-app.vercel.app) — where
+// the password-reset link sends people. If unset, the project's "Site URL"
+// setting (Authentication -> URL Configuration) is used.
+// SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are
+// provided automatically.
+
+import { createClient } from "https://esm.sh/@supabase/supabase-js@2.45.4";
+
+const SUPABASE_URL = Deno.env.get("SUPABASE_URL");
+const SUPABASE_ANON_KEY = Deno.env.get("SUPABASE_ANON_KEY");
+const SUPABASE_SERVICE_ROLE_KEY = Deno.env.get("SUPABASE_SERVICE_ROLE_KEY");
+const SITE_URL = Deno.env.get("SITE_URL");
+
+const ADMIN_EMAIL = "admin@choumchoum.com";
+// "Disabled" = banned for ~100 years; enabling clears the ban.
+const BAN_FOREVER = "876000h";
+const ACTIONS = ["reset_password", "disable", "enable", "delete"];
+const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
+
+const corsHeaders = {
+  "Access-Control-Allow-Origin": "*",
+  "Access-Control-Allow-Headers": "authorization, x-client-info, apikey, content-type",
+  "Access-Control-Allow-Methods": "POST, OPTIONS",
+};
+
+function json(data, status = 200) {
+  return new Response(JSON.stringify(data), {
+    status,
+    headers: { ...corsHeaders, "Content-Type": "application/json" },
+  });
+}
+
+class HttpError extends Error {
+  constructor(status, message) {
+    super(message);
+    this.status = status;
+  }
+}
+
+function isAdmin(user) {
+  return (
+    Boolean(user?.email) &&
+    user.email.toLowerCase() === ADMIN_EMAIL &&
+    Boolean(user.email_confirmed_at)
+  );
+}
+
+async function removeAvatars(admin, userId) {
+  // Best effort: avatars live under "<user id>/" in the avatars bucket.
+  try {
+    const { data: files } = await admin.storage.from("avatars").list(userId);
+    if (files && files.length > 0) {
+      await admin.storage.from("avatars").remove(files.map((f) => `${userId}/${f.name}`));
+    }
+  } catch (_err) {
+    // Not worth failing the deletion over a leftover image.
+  }
+}
+
+async function handle(req) {
+  if (req.method !== "POST") throw new HttpError(405, "Method not allowed.");
+
+  const authHeader = req.headers.get("Authorization");
+  if (!authHeader) throw new HttpError(401, "Missing authorization header.");
+
+  // 1. Who is calling? Ask Supabase to validate their token.
+  const caller = createClient(SUPABASE_URL, SUPABASE_ANON_KEY, {
+    global: { headers: { Authorization: authHeader } },
+  });
+  const {
+    data: { user },
+    error: authError,
+  } = await caller.auth.getUser();
+  if (authError || !user) throw new HttpError(401, "Unauthorized.");
+  if (!isAdmin(user)) throw new HttpError(403, "Admins only.");
+
+  // 2. What do they want?
+  let body;
+  try {
+    body = await req.json();
+  } catch (_err) {
+    throw new HttpError(400, "Invalid request body.");
+  }
+  const { action, userId } = body || {};
+  if (!ACTIONS.includes(action)) throw new HttpError(400, "Unknown action.");
+  if (typeof userId !== "string" || !UUID_RE.test(userId)) {
+    throw new HttpError(400, "Invalid user id.");
+  }
+
+  // 3. Look the target up with the privileged client.
+  const admin = createClient(SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, {
+    auth: { autoRefreshToken: false, persistSession: false },
+  });
+  const { data: found, error: findError } = await admin.auth.admin.getUserById(userId);
+  const target = found?.user;
+  if (findError || !target) throw new HttpError(404, "User not found.");
+
+  // The admin account can never be disabled, deleted or reset from here.
+  if (target.id === user.id || (target.email || "").toLowerCase() === ADMIN_EMAIL) {
+    throw new HttpError(400, "The admin account can't be changed from here.");
+  }
+
+  console.log(JSON.stringify({ admin: user.email, action, target: target.id }));
+
+  if (action === "disable" || action === "enable") {
+    const { error } = await admin.auth.admin.updateUserById(target.id, {
+      ban_duration: action === "disable" ? BAN_FOREVER : "none",
+    });
+    if (error) throw new HttpError(400, error.message);
+    return { ok: true, action };
+  }
+
+  if (action === "reset_password") {
+    if (!target.email) throw new HttpError(400, "This user has no email address.");
+    const anon = createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
+    const { error } = await anon.auth.resetPasswordForEmail(
+      target.email,
+      SITE_URL ? { redirectTo: SITE_URL } : undefined
+    );
+    if (error) throw new HttpError(400, error.message);
+    return { ok: true, action };
+  }
+
+  // action === "delete" — irreversible, so the caller must also send the
+  // user's exact email as a typed confirmation, checked here, not just in
+  // the UI.
+  const confirmEmail = typeof body.confirmEmail === "string" ? body.confirmEmail.trim().toLowerCase() : "";
+  if (!confirmEmail || confirmEmail !== (target.email || "").toLowerCase()) {
+    throw new HttpError(400, "Confirmation email doesn't match.");
+  }
+  await removeAvatars(admin, target.id);
+  // Rows in accounts, transactions, budgets, goals, loans etc. are removed
+  // automatically (they reference auth.users with ON DELETE CASCADE).
+  const { error: deleteError } = await admin.auth.admin.deleteUser(target.id);
+  if (deleteError) throw new HttpError(400, deleteError.message);
+  return { ok: true, action };
+}
+
+Deno.serve(async (req) => {
+  if (req.method === "OPTIONS") {
+    return new Response("ok", { headers: corsHeaders });
+  }
+  try {
+    return json(await handle(req));
+  } catch (err) {
+    return json({ error: err.message || "Something went wrong." }, err.status || 400);
+  }
+});
diff --git a/supabase/migration-011-admin-adoption.sql b/supabase/migration-011-admin-adoption.sql
new file mode 100644
index 0000000..f68cad7
--- /dev/null
+++ b/supabase/migration-011-admin-adoption.sql
@@ -0,0 +1,49 @@
+-- Run this once in your Supabase project's SQL Editor.
+-- Adds admin_feature_adoption(): for each feature, how many distinct
+-- users have used it. Same admin-only check as admin_list_users():
+-- anyone other than the confirmed admin@choumchoum.com gets
+-- "not authorized".
+--
+-- Note: AI chat usage is not stored per user anywhere, so it can't be
+-- counted here.
+
+create or replace function public.admin_feature_adoption()
+returns table (
+  total_users bigint,
+  with_budgets bigint,
+  with_recurring bigint,
+  with_goals bigint,
+  with_loans bigint,
+  with_custom_categories bigint,
+  with_push bigint
+)
+language plpgsql
+security definer
+set search_path = public, auth
+stable
+as $$
+begin
+  if not exists (
+    select 1
+    from auth.users au
+    where au.id = auth.uid()
+      and lower(au.email) = 'admin@choumchoum.com'
+      and au.email_confirmed_at is not null
+  ) then
+    raise exception 'not authorized' using errcode = '42501';
+  end if;
+
+  return query
+  select
+    (select count(*) from auth.users),
+    (select count(distinct b.user_id) from public.budgets b),
+    (select count(distinct r.user_id) from public.recurring_rules r),
+    (select count(distinct g.user_id) from public.savings_goals g),
+    (select count(distinct l.user_id) from public.loans l),
+    (select count(distinct c.user_id) from public.categories c),
+    (select count(distinct p.user_id) from public.push_subscriptions p);
+end;
+$$;
+
+revoke all on function public.admin_feature_adoption() from public, anon;
+grant execute on function public.admin_feature_adoption() to authenticated;
diff --git a/supabase/migration-012-admin-status.sql b/supabase/migration-012-admin-status.sql
new file mode 100644
index 0000000..02ac6db
--- /dev/null
+++ b/supabase/migration-012-admin-status.sql
@@ -0,0 +1,101 @@
+-- Run this once in your Supabase project's SQL Editor, AFTER
+-- migration-010-admin-activity.sql.
+-- Replaces admin_list_users() so it also returns banned_until, which the
+-- Admin tab uses to show which accounts are disabled. Same admin-only
+-- check as before.
+
+drop function if exists public.admin_list_users();
+
+create function public.admin_list_users()
+returns table (
+  id uuid,
+  email text,
+  first_name text,
+  last_name text,
+  created_at timestamptz,
+  last_sign_in_at timestamptz,
+  balance_mad numeric,
+  balance_eur numeric,
+  balance_usd numeric,
+  tx_count bigint,
+  account_count bigint,
+  last_tx_date date,
+  banned_until timestamptz
+)
+language plpgsql
+security definer
+set search_path = public, auth
+stable
+as $$
+begin
+  if not exists (
+    select 1
+    from auth.users au
+    where au.id = auth.uid()
+      and lower(au.email) = 'admin@choumchoum.com'
+      and au.email_confirmed_at is not null
+  ) then
+    raise exception 'not authorized' using errcode = '42501';
+  end if;
+
+  return query
+  with opening as (
+    select a.user_id, coalesce(a.currency, 'MAD') as currency,
+           sum(coalesce(a.opening_balance, 0)) as amount
+    from public.accounts a
+    group by a.user_id, coalesce(a.currency, 'MAD')
+  ),
+  moves as (
+    select t.user_id, coalesce(a.currency, 'MAD') as currency,
+           sum(case when t.type = 'income' then t.amount else -t.amount end) as amount
+    from public.transactions t
+    left join public.accounts a on a.id = t.account_id
+    group by t.user_id, coalesce(a.currency, 'MAD')
+  ),
+  combined as (
+    select o.user_id, o.currency, o.amount from opening o
+    union all
+    select m.user_id, m.currency, m.amount from moves m
+  ),
+  totals as (
+    select c.user_id,
+      coalesce(sum(c.amount) filter (where c.currency = 'MAD'), 0) as mad,
+      coalesce(sum(c.amount) filter (where c.currency = 'EUR'), 0) as eur,
+      coalesce(sum(c.amount) filter (where c.currency = 'USD'), 0) as usd
+    from combined c
+    group by c.user_id
+  ),
+  tx_stats as (
+    select t.user_id, count(*) as n_tx, max(t.date) as last_date
+    from public.transactions t
+    group by t.user_id
+  ),
+  acct_stats as (
+    select a.user_id, count(*) as n_acct
+    from public.accounts a
+    group by a.user_id
+  )
+  select
+    u.id,
+    u.email::text,
+    coalesce(u.raw_user_meta_data->>'first_name', '')::text,
+    coalesce(u.raw_user_meta_data->>'last_name', '')::text,
+    u.created_at,
+    u.last_sign_in_at,
+    coalesce(tt.mad, 0),
+    coalesce(tt.eur, 0),
+    coalesce(tt.usd, 0),
+    coalesce(ts.n_tx, 0)::bigint,
+    coalesce(ac.n_acct, 0)::bigint,
+    ts.last_date::date,
+    u.banned_until
+  from auth.users u
+  left join totals tt on tt.user_id = u.id
+  left join tx_stats ts on ts.user_id = u.id
+  left join acct_stats ac on ac.user_id = u.id
+  order by u.created_at desc;
+end;
+$$;
+
+revoke all on function public.admin_list_users() from public, anon;
+grant execute on function public.admin_list_users() to authenticated;
